ROUTERAI_API_KEY=
SHERI_MODEL=openai/gpt-6.1-terra
SHERI_REASONING_EFFORT=medium

# Нужно только для режима twitch
TWITCH_CLIENT_ID=

# Голос: одинаковая длинная случайная строка на сервере и клиенте
VOICE_TOKEN=
VOICE_PORT=8765
