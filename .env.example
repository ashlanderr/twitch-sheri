ROUTERAI_API_KEY=
SHERI_MODEL=openai/gpt-6.1-terra
SHERI_REASONING_EFFORT=medium

# Нужно только для режима twitch
TWITCH_CLIENT_ID=

# Связь со стрим-компом (голос и снимки экрана):
# одинаковая длинная случайная строка у бота и на стрим-компе
STREAM_PC_TOKEN=
STREAM_PC_PORT=8765
STT_MODEL=v3_e2e_rnnt

# Снимки экрана, нужно только на стрим-компе: пароль из OBS,
# Инструменты → Настройки сервера WebSocket
OBS_PASSWORD=
